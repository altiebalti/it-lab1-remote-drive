FROM node:20-alpine AS builder
WORKDIR /repo

ENV CI=true
RUN corepack enable && corepack prepare pnpm@10.33.0 --activate

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY apps/server/package.json        apps/server/
COPY packages/core/package.json      packages/core/
COPY packages/api-client/package.json packages/api-client/
COPY packages/ui/package.json        packages/ui/

RUN pnpm install --frozen-lockfile \
      --filter @drive/server... \
      --filter @drive/core...

COPY packages/core packages/core
COPY apps/server   apps/server
COPY tools/write-esm-package.mjs tools/write-esm-package.mjs

RUN pnpm --filter @drive/core build \
 && pnpm --filter @drive/server build

RUN pnpm install --prod --frozen-lockfile \
      --filter @drive/server... --filter @drive/core...

FROM node:20-alpine AS runtime
WORKDIR /repo
ENV NODE_ENV=production

RUN addgroup -S drive && adduser -S drive -G drive

COPY --from=builder --chown=drive:drive /repo/node_modules            ./node_modules
COPY --from=builder --chown=drive:drive /repo/packages/core           ./packages/core
COPY --from=builder --chown=drive:drive /repo/apps/server/node_modules ./apps/server/node_modules
COPY --from=builder --chown=drive:drive /repo/apps/server/dist        ./apps/server/dist
COPY --from=builder --chown=drive:drive /repo/apps/server/package.json ./apps/server/

USER drive
EXPOSE 3002
CMD ["node", "apps/server/dist/main.js"]
