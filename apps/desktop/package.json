{
  "name": "@drive/desktop",
  "version": "1.0.0",
  "private": true,
  "description": "Десктоп-клієнт віддаленого диска. Етап 2.",
  "main": "dist-electron/main.js",
  "scripts": {
    "build:electron": "tsc -p tsconfig.electron.json",
    "build:renderer": "vite build",
    "build": "pnpm build:electron && pnpm build:renderer",
    "dev": "pnpm build:electron && concurrently -k -n vite,electron -c cyan,yellow \"vite\" \"wait-on tcp:5273 && cross-env DRIVE_DEV=1 electron .\"",
    "start": "pnpm build && electron ."
  },
  "dependencies": {
    "@drive/api-client": "workspace:*",
    "@drive/core": "workspace:*",
    "@drive/ui": "workspace:*",
    "chokidar": "^4.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "concurrently": "^9.1.0",
    "cross-env": "^7.0.3",
    "electron": "^33.0.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "wait-on": "^8.0.0"
  }
}
