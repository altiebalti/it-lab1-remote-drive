{
  "name": "@drive/api-client",
  "version": "1.0.0",
  "private": true,
  "main": "./dist/cjs/index.js",
  "types": "./dist/cjs/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json && tsc -p tsconfig.esm.json && node ../../tools/write-esm-package.mjs dist/esm"
  },
  "dependencies": {
    "@drive/core": "workspace:*",
    "axios": "^1.7.0"
  },
  "devDependencies": {
    "typescript": "^5.7.0"
  },
  "module": "./dist/esm/index.js",
  "exports": {
    ".": {
      "types": "./dist/cjs/index.d.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.js"
    }
  }
}
